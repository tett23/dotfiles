# 通常は ~/.zshenv (zsh/zshenv) で設定済み。無い場合はこのファイルの実体から求める
export DOTFILES="${DOTFILES:-${${(%):-%x}:A:h:h}}"

source $DOTFILES/zsh/lib/cached-eval.zsh

source $DOTFILES/zsh/exports.sh
source $DOTFILES/zsh/common.sh
source $DOTFILES/zsh/aliases.sh
source $DOTFILES/zsh/prompt.sh
__cached_eval fzf fzf --zsh  # キーバインド・補完 (docs/adr/0002)。出力はキャッシュする (docs/adr/0011)
source $DOTFILES/zsh/fzf.sh
source $DOTFILES/zsh/docker.sh
source $DOTFILES/zsh/langs/go.sh
source $DOTFILES/zsh/langs/ruby.sh
source $DOTFILES/zsh/langs/swift.sh
source $DOTFILES/zsh/langs/scala.sh

# 言語/ツールは mise で一元管理。langs/* の後に activate して shims を最優先にする
__cached_eval mise mise activate zsh

source $DOTFILES/zsh/plugins.sh
# compinit はプラグインの fpath 追加より後に実行する
source $DOTFILES/zsh/completions.sh

## load user .zshrc configuration file
[ -f ~/.zshrc.mine ] && source ~/.zshrc.mine

__cached_eval direnv direnv hook zsh

# ~/.local/bin は exports.sh で PATH に入っている。uv のインストーラが追記する
# `. ~/.local/bin/env` は ~/.local/bin を PATH の先頭に足し mise より優先させるので読み込まない (docs/adr/0023)
