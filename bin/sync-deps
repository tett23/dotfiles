#!/usr/bin/env bash
#
# sync-deps - dependencies.md から Nix / mise の設定を Claude で生成する (docs/adr/0013)
#
#   1. claude -p (Claude Code の非対話モード) に dependencies.md と現在の実装を読ませ、
#      flake.nix / mise/config.toml / nix/pkgs/ を更新させる
#      (手順と名前の対応表は .claude/skills/sync-deps/SKILL.md に従わせる)
#   2. 一般ユーザーで nix build して、生成された設定を検証する
#   3. 生成の対象の外のファイルと、生成の前の写しが変わっていないことを確かめる (変わっていれば止める。docs/adr/0133)
#   4. 変更の差分の全体を表示する
#   5. --switch のときだけ、端末で確認を取ってから適用する (darwin-rebuild switch と mise install。docs/adr/0133)
#
# バージョンの最新化は bin/update-nix / bin/update-mise で行う。
#
# 使い方:
#   sync-deps                    生成と検証だけ行う
#   sync-deps --switch           生成・検証のあと、確認を取って適用する
#
# 環境変数:
#   SYNC_DEPS_TTY   確認の答えを読むファイル (既定: /dev/tty)。標準入力からは読まない
#   sync-deps --model <モデル>    使う Claude のモデルを指定する (既定: Claude Code の既定)
#
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
HOST="dione"

# 生成対象。差分の表示もこの範囲に限る
TARGETS=(flake.nix flake.lock mise/config.toml nix)

# Claude に使わせるツール。ファイルの読み書きと、読み取り・ビルド系のコマンドだけ
ALLOWED_TOOLS=(
  Read Edit Write Glob Grep
  "Bash(nix search:*)"
  "Bash(nix eval:*)"
  "Bash(nix build:*)"
  "Bash(nix flake lock:*)"
  "Bash(nix flake show:*)"
  "Bash(nix store prefetch-file:*)"
  "Bash(nix-prefetch-url:*)"
  # Homebrew の公開 API は、このドメインだけを読める WebFetch で取る (curl の前方一致の許可は広すぎるため。docs/adr/0045)
  "WebFetch(domain:formulae.brew.sh)"
  "Bash(git diff:*)"
  "Bash(git status:*)"
  "Bash(git add -N:*)"
  "Bash(mise ls:*)"
  "Bash(mise registry:*)"
)
# 明示的に禁止するもの (許可リストに無いものも使えないが、念のため)
DISALLOWED_TOOLS=(
  "Bash(sudo:*)"
  "Bash(darwin-rebuild:*)"
  "Bash(home-manager:*)"
  "Bash(git commit:*)"
  "Bash(git push:*)"
  "Bash(mise install:*)"
  "Bash(rm:*)"
)

# shellcheck disable=SC2016 # プロンプト中のバッククォートは展開させない
PROMPT='dependencies.md を一次ソースとして、flake.nix / mise/config.toml / nix/pkgs/ を同期してください。

- 手順と名前の対応表は .claude/skills/sync-deps/SKILL.md の「名前マッピング」「1. 差分検出」「2. 同期」に従ってください。
  「3. 適用」以降は行いません (適用はこのスクリプトが行います)。
- 非対話で実行されているので、ユーザーに質問できません。次の場合は変更せず、最後の報告に書いてください。
  - 実装側にあって dependencies.md に無いもの (削除候補)
  - nixpkgs に見つからない、または対応が曖昧なパッケージ
- nix/ に新しいファイルを作ったら `git add -N <ファイル>` を実行してください (flake から見えるようにするため)。
- 変更したら `nix build --no-link .#darwinConfigurations.dione.system` でビルドが通ることを確認してください。
- sudo、darwin-rebuild、home-manager switch、mise install、git commit は使わないでください。
- 最後に、変更したファイルと内容、変更しなかった理由、ユーザーの判断が必要な点を日本語で簡潔に報告してください。
  差分が無ければ「差分なし」と報告してください。'

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==> WARN:\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2
  exit 1
}

generate() {
  local model_args=()
  [[ -n $1 ]] && model_args=(--model "$1")

  log "Claude で dependencies.md から設定を生成します"
  (
    cd "$DOTFILES"
    claude -p "$PROMPT" \
      ${model_args[@]+"${model_args[@]}"} \
      --permission-mode acceptEdits \
      --allowedTools "${ALLOWED_TOOLS[@]}" \
      --disallowedTools "${DISALLOWED_TOOLS[@]}"
  )
}

verify() {
  log "生成された設定をビルドして検証します"
  nix build --no-link "$DOTFILES#darwinConfigurations.${HOST}.system" ||
    die "ビルドに失敗しました。差分を確認してください: git -C $DOTFILES diff -- ${TARGETS[*]}"
}

# 生成前の状態を控える。作業中の未コミットの変更と区別して、Claude の変更だけを表示するため
snapshot() {
  SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/sync-deps.XXXXXX")
  local target
  for target in "${TARGETS[@]}"; do
    if [[ -e $DOTFILES/$target ]]; then
      mkdir -p "$SNAPSHOT/$(dirname "$target")"
      cp -R "$DOTFILES/$target" "$SNAPSHOT/$target"
    fi
  done
}

# hash_list <ディレクトリ>: 標準入力の NUL 区切りのパスについて「ハッシュ<TAB>パス」を並べて出す
hash_list() {
  local dir=$1 path
  while IFS= read -r -d '' path; do
    path=${path#./}
    if [[ -L $dir/$path ]]; then
      printf 'link:%s\t%s\n' "$(readlink "$dir/$path")" "$path"
    elif [[ -f $dir/$path ]]; then
      printf '%s\t%s\n' "$(git -C "$DOTFILES" hash-object --no-filters -- "$dir/$path")" "$path"
    else
      printf 'missing\t%s\n' "$path"
    fi
  done | LC_ALL=C sort
}

# 作業ツリーのファイル (git が追跡しているものと、除いていない追跡していないもの) の一覧。flake が読みうるファイルを含む
worktree_list() { git -C "$DOTFILES" ls-files -c -o --exclude-standard -z | hash_list "$DOTFILES"; }
# 生成の前の写しのファイルの一覧
snapshot_list() { (cd "$SNAPSHOT" && find . \( -type f -o -type l \) -print0) | hash_list "$SNAPSHOT"; }

in_targets() {
  local target
  for target in "${TARGETS[@]}"; do
    [[ $1 == "$target" || $1 == "$target"/* ]] && return 0
  done
  return 1
}

# 生成の後に、生成の前の写しと、TARGETS の外のファイルが変わっていないことを確かめる。変わっていれば止める (docs/adr/0133)。
# 比べる元の一覧はこのプロセスの変数にあるので、claude -p は書き換えられない
check_untouched() {
  local path changed outside=()
  [[ $(snapshot_list) == "$SNAPSHOT_LIST" ]] || die "生成の前の写しが変わりました。差分を信用できないので適用しません"
  # 生成の前と後の一覧で、片方にだけある行のパスを出す
  changed=$({
    printf '%s\n' "$WORKTREE_LIST"
    printf '%s\n' '--after--'
    worktree_list
  } | awk -F '\t' '
    $0 == "--after--" { after = 1; next }
    !after { before[$0] = $2; next }
    { if ($0 in before) delete before[$0]; else print $2 }
    END { for (k in before) print before[k] }
  ' | LC_ALL=C sort -u)
  while IFS= read -r path; do
    [[ -n $path ]] || continue
    in_targets "$path" || outside+=("$path")
  done <<<"$changed"
  if ((${#outside[@]} > 0)); then
    printf '%s\n' "${outside[@]}" >&2
    die "生成の対象 (${TARGETS[*]}) の外のファイルが変わりました。適用しません"
  fi
}

# 生成前の状態と比べて、変更があれば差分の全体を表示する。変更が無ければ 1 を返す
show_diff() {
  log "Claude による変更の差分"
  local target changed=1
  for target in "${TARGETS[@]}"; do
    [[ -e $SNAPSHOT/$target || -e $DOTFILES/$target ]] || continue
    # git diff --no-index は差分があると 1 を返す
    if ! git --no-pager diff --no-index --stat -- "$SNAPSHOT/$target" "$DOTFILES/$target" 2>/dev/null; then
      changed=0
    fi
  done
  if ((changed)); then
    log "差分はありません"
    return 1
  fi
  for target in "${TARGETS[@]}"; do
    [[ -e $SNAPSHOT/$target || -e $DOTFILES/$target ]] || continue
    git --no-pager diff --no-index -- "$SNAPSHOT/$target" "$DOTFILES/$target" 2>/dev/null || true
  done
  return 0
}

# 端末から答えを読み、y か yes (大文字と小文字を区別しない) のときだけ 0 を返す。標準入力からは読まない (docs/adr/0133)
confirm() {
  local answer=""
  printf '適用しますか? [y/N] '
  IFS= read -r answer <"${SYNC_DEPS_TTY:-/dev/tty}" 2>/dev/null || true
  printf '\n'
  case $(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]') in
  y | yes) return 0 ;;
  *) return 1 ;;
  esac
}

switch() {
  log "darwin-rebuild switch で適用します (sudo)"
  if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "$DOTFILES#$HOST"
  else
    # nix-darwin は flake.lock で固定した版を使う (docs/adr/0017)
    sudo nix --extra-experimental-features "nix-command flakes" \
      run --inputs-from "$DOTFILES" nix-darwin -- switch --flake "$DOTFILES#$HOST"
  fi
  log "mise install を実行します"
  mise install --yes
}

main() {
  local do_switch=0 model=""
  while (($# > 0)); do
    case "$1" in
    --switch) do_switch=1 ;;
    --model)
      [[ $# -ge 2 ]] || die "--model にはモデル名が必要です"
      model=$2
      shift
      ;;
    *) die "不明な引数です: $1" ;;
    esac
    shift
  done

  command -v claude >/dev/null 2>&1 || die "claude (Claude Code) が見つかりません"
  [[ -f $DOTFILES/dependencies.md ]] || die "$DOTFILES/dependencies.md がありません"

  snapshot
  trap 'command rm -r -- "$SNAPSHOT"' EXIT
  WORKTREE_LIST=$(worktree_list)
  SNAPSHOT_LIST=$(snapshot_list)
  generate "$model"
  verify
  check_untouched
  if ! show_diff; then
    ((do_switch)) && log "差分が無いので適用しません"
    return 0
  fi
  if ((do_switch)); then
    confirm || die "適用しませんでした"
    switch
    log "完了しました"
  else
    log "適用するには: sync-deps --switch (または sudo darwin-rebuild switch --flake $DOTFILES#$HOST)"
  fi
}

# source されたときは関数の定義だけ行う (テスト用)
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
