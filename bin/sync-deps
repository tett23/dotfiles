#!/usr/bin/env bash
#
# sync-deps - dependencies.md から Nix / mise の設定を Claude で生成する (docs/adr/0013)
#
#   1. claude -p (Claude Code の非対話モード) に dependencies.md と現在の実装を読ませ、
#      flake.nix / mise/config.toml / nix/pkgs/ を更新させる
#      (手順と名前の対応表は .claude/skills/sync-deps/SKILL.md に従わせる)
#   2. 一般ユーザーで nix build して、生成された設定を検証する
#   3. 変更の差分を表示する
#   4. --switch のときだけ適用する (darwin-rebuild switch と mise install。sudo のパスワードを聞かれる)
#
# バージョンの最新化は bin/update-nix / bin/update-mise で行う。
#
# 使い方:
#   sync-deps                    生成と検証だけ行う
#   sync-deps --switch           生成・検証のあと適用する
#   sync-deps --model <モデル>    使う Claude のモデルを指定する (既定: Claude Code の既定)
#
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
HOST="dione"

# 生成対象。差分の表示もこの範囲に限る
TARGETS=(flake.nix flake.lock mise/config.toml nix)

# Claude に使わせるツール。ファイルの読み書きと、読み取り・ビルド系のコマンドだけ
ALLOWED_TOOLS=(
  Read Edit Write Glob Grep
  "Bash(nix search:*)"
  "Bash(nix eval:*)"
  "Bash(nix build:*)"
  "Bash(nix flake lock:*)"
  "Bash(nix flake show:*)"
  "Bash(nix store prefetch-file:*)"
  "Bash(nix-prefetch-url:*)"
  "Bash(curl -fsSL https://formulae.brew.sh/:*)"
  "Bash(git diff:*)"
  "Bash(git status:*)"
  "Bash(git add -N:*)"
  "Bash(mise ls:*)"
  "Bash(mise registry:*)"
)
# 明示的に禁止するもの (許可リストに無いものも使えないが、念のため)
DISALLOWED_TOOLS=(
  "Bash(sudo:*)"
  "Bash(darwin-rebuild:*)"
  "Bash(home-manager:*)"
  "Bash(git commit:*)"
  "Bash(git push:*)"
  "Bash(mise install:*)"
  "Bash(rm:*)"
)

# shellcheck disable=SC2016 # プロンプト中のバッククォートは展開させない
PROMPT='dependencies.md を一次ソースとして、flake.nix / mise/config.toml / nix/pkgs/ を同期してください。

- 手順と名前の対応表は .claude/skills/sync-deps/SKILL.md の「名前マッピング」「1. 差分検出」「2. 同期」に従ってください。
  「3. 適用」以降は行いません (適用はこのスクリプトが行います)。
- 非対話で実行されているので、ユーザーに質問できません。次の場合は変更せず、最後の報告に書いてください。
  - 実装側にあって dependencies.md に無いもの (削除候補)
  - nixpkgs に見つからない、または対応が曖昧なパッケージ
- nix/ に新しいファイルを作ったら `git add -N <ファイル>` を実行してください (flake から見えるようにするため)。
- 変更したら `nix build --no-link .#darwinConfigurations.dione.system` でビルドが通ることを確認してください。
- sudo、darwin-rebuild、home-manager switch、mise install、git commit は使わないでください。
- 最後に、変更したファイルと内容、変更しなかった理由、ユーザーの判断が必要な点を日本語で簡潔に報告してください。
  差分が無ければ「差分なし」と報告してください。'

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==> WARN:\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2
  exit 1
}

generate() {
  local model_args=()
  [[ -n $1 ]] && model_args=(--model "$1")

  log "Claude で dependencies.md から設定を生成します"
  (
    cd "$DOTFILES"
    claude -p "$PROMPT" \
      ${model_args[@]+"${model_args[@]}"} \
      --permission-mode acceptEdits \
      --allowedTools "${ALLOWED_TOOLS[@]}" \
      --disallowedTools "${DISALLOWED_TOOLS[@]}"
  )
}

verify() {
  log "生成された設定をビルドして検証します"
  nix build --no-link "$DOTFILES#darwinConfigurations.${HOST}.system" ||
    die "ビルドに失敗しました。差分を確認してください: git -C $DOTFILES diff -- ${TARGETS[*]}"
}

# 生成前の状態を控える。作業中の未コミットの変更と区別して、Claude の変更だけを表示するため
snapshot() {
  SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/sync-deps.XXXXXX")
  local target
  for target in "${TARGETS[@]}"; do
    if [[ -e $DOTFILES/$target ]]; then
      mkdir -p "$SNAPSHOT/$(dirname "$target")"
      cp -R "$DOTFILES/$target" "$SNAPSHOT/$target"
    fi
  done
}

# 生成前の状態と比べて、変更があれば差分を表示する。変更が無ければ 1 を返す
show_diff() {
  log "Claude による変更の差分"
  local target changed=1
  for target in "${TARGETS[@]}"; do
    # git diff --no-index は差分があると 1 を返す
    if ! git --no-pager diff --no-index --stat -- "$SNAPSHOT/$target" "$DOTFILES/$target" 2>/dev/null; then
      changed=0
    fi
  done
  if ((changed)); then
    log "差分はありません"
  fi
  return "$changed"
}

switch() {
  log "darwin-rebuild switch で適用します (sudo)"
  if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "$DOTFILES#$HOST"
  else
    # nix-darwin は flake.lock で固定した版を使う (docs/adr/0017)
    sudo nix --extra-experimental-features "nix-command flakes" \
      run --inputs-from "$DOTFILES" nix-darwin -- switch --flake "$DOTFILES#$HOST"
  fi
  log "mise install を実行します"
  mise install --yes
}

main() {
  local do_switch=0 model=""
  while (($# > 0)); do
    case "$1" in
    --switch) do_switch=1 ;;
    --model)
      [[ $# -ge 2 ]] || die "--model にはモデル名が必要です"
      model=$2
      shift
      ;;
    *) die "不明な引数です: $1" ;;
    esac
    shift
  done

  command -v claude >/dev/null 2>&1 || die "claude (Claude Code) が見つかりません"
  [[ -f $DOTFILES/dependencies.md ]] || die "$DOTFILES/dependencies.md がありません"

  snapshot
  trap 'command rm -r -- "$SNAPSHOT"' EXIT
  generate "$model"
  verify
  if show_diff && ((do_switch)); then
    switch
    log "完了しました"
  elif ((do_switch)); then
    log "差分が無いので適用しません"
  else
    log "適用するには: sync-deps --switch (または sudo darwin-rebuild switch --flake $DOTFILES#$HOST)"
  fi
}

# source されたときは関数の定義だけ行う (テスト用)
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
