#!/usr/bin/env bash
#
# update-nix - Nix で管理しているパッケージを最新化する (docs/adr/0012)
#
#   0. 自前パッケージの取得元を確かめる (URL の接頭辞と GitHub のリリースの digest。docs/adr/0139)
#   1. flake.lock を更新する (nixpkgs / nix-darwin / home-manager など)
#   2. nixpkgs に無い自前パッケージ (nix/pkgs/sources.json) を最新版にする
#      最新版は Homebrew の公開 API (formulae.brew.sh) から調べる。Homebrew 本体は使わない
#   3. 一般ユーザーでビルドして失敗を早めに検出する
#   4. 差分を見せ、端末 (UPDATE_NIX_TTY) で y か yes と答えたときだけ darwin-rebuild switch で適用する (sudo)
#
# 使い方:
#   update-nix              更新して適用する
#   update-nix --no-switch  更新とビルドだけ行い、適用しない
#
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
HOST="dione"
SOURCES="$DOTFILES/nix/pkgs/sources.json"

# "sources.json のキー Homebrew の cask 名 許す URL の接頭辞" の空白区切り。接頭辞が : を含むので空白で区切る
# (macOS の bash 3.2 でも動くよう連想配列は使わない。docs/adr/0139)
SOURCES_TO_CASKS=(
  "claude-desktop claude https://downloads.claude.ai/"
  "aquaskk aquaskk https://github.com/codefirst/aquaskk/releases/download/"
)

# 確かめた結果。SOURCES_TO_CASKS と同じ順に、キー、版、URL、sha256 を持つ
VERIFIED_NAMES=()
VERIFIED_VERSIONS=()
VERIFIED_URLS=()
VERIFIED_SHAS=()
SNAPSHOT=""

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==> WARNING:\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2
  exit 1
}

update_flake() {
  log "flake.lock を更新します"
  nix flake update --flake "$DOTFILES"
}

# GitHub のリリースの URL なら、リリースの API の asset の digest と sha256 を比べる (docs/adr/0139)
verify_github_digest() {
  local name=$1 url=$2 sha256=$3
  local re='^https://github\.com/([^/]+)/([^/]+)/releases/download/([^/]+)/([^/]+)$'
  [[ $url =~ $re ]] || return 0
  local owner=${BASH_REMATCH[1]} repo=${BASH_REMATCH[2]} tag=${BASH_REMATCH[3]} asset=${BASH_REMATCH[4]}
  local json digest
  json=$(curl -fsSL -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$owner/$repo/releases/tags/$tag") ||
    die "$name の GitHub のリリース ($owner/$repo $tag) を取得できませんでした"
  digest=$(jq -r --arg a "$asset" '[.assets[] | select(.name == $a)] | if length == 0 then "missing" else (.[0].digest // "null") end' <<<"$json") ||
    die "$name の GitHub のリリースの応答を読めませんでした"
  case $digest in
  missing) die "$name の GitHub のリリースに $asset がありません" ;;
  null) warn "$name: GitHub のリリースにハッシュがありません。Homebrew の sha256 だけで確かめます" ;;
  "sha256:$sha256") log "$name の sha256 は GitHub のリリースの digest と一致しました" ;;
  *) die "$name の sha256 ($sha256) が GitHub のリリースの digest ($digest) と違います" ;;
  esac
}

# 自前パッケージ 1 つの最新版を Homebrew の API から取り、取得元を確かめる。ファイルは書かない
verify_source() {
  local name=$1 cask=$2 prefix=$3 json version url sha256
  json=$(curl -fsSL "https://formulae.brew.sh/api/cask/${cask}.json") ||
    die "$cask の情報を取得できませんでした"

  # cask のバージョンは "2.26454.0,<コミット>" のようにカンマ以降を含むことがある
  version=$(jq -r '.version | split(",")[0]' <<<"$json")
  url=$(jq -r '.url' <<<"$json")
  sha256=$(jq -r '.sha256' <<<"$json")
  [[ $sha256 =~ ^[0-9a-f]{64}$ ]] || die "$cask の sha256 が取得できませんでした: $sha256"
  [[ $url == "$prefix"* ]] || die "$name の URL ($url) が許す接頭辞 ($prefix) で始まりません"
  verify_github_digest "$name" "$url" "$sha256"

  VERIFIED_NAMES+=("$name")
  VERIFIED_VERSIONS+=("$version")
  VERIFIED_URLS+=("$url")
  VERIFIED_SHAS+=("$sha256")
}

verify_sources() {
  log "自前パッケージの取得元を確かめます"
  local entry name cask prefix
  for entry in "${SOURCES_TO_CASKS[@]}"; do
    read -r name cask prefix <<<"$entry"
    verify_source "$name" "$cask" "$prefix"
  done
}

# 確かめた版が今と違うパッケージだけ、sources.json を書き換える
update_sources() {
  local i name version current tmp
  for i in "${!VERIFIED_NAMES[@]}"; do
    name=${VERIFIED_NAMES[$i]}
    version=${VERIFIED_VERSIONS[$i]}
    current=$(jq -r --arg n "$name" '.[$n].version' "$SOURCES")
    if [[ $current == "$version" ]]; then
      log "$name は最新です ($version)"
      continue
    fi
    log "$name を更新します: $current -> $version"
    tmp=$SNAPSHOT/new.json
    jq --arg n "$name" --arg v "$version" --arg u "${VERIFIED_URLS[$i]}" --arg s "${VERIFIED_SHAS[$i]}" \
      '.[$n] = {version: $v, url: $u, sha256: $s}' "$SOURCES" >"$tmp"
    mv "$tmp" "$SOURCES"
  done
}

# 更新の前の flake.lock と sources.json を写す。実行の前からの未コミットの変更は差分に出ない
snapshot() {
  SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/update-nix.XXXXXX")
  trap 'rm -rf "$SNAPSHOT"' EXIT
  cp "$DOTFILES/flake.lock" "$SNAPSHOT/flake.lock"
  cp "$SOURCES" "$SNAPSHOT/sources.json"
}

# 写しと今のファイルの差分の全体を出す。差分が無ければ 1 を返す
show_diff() {
  local changed=1
  # git diff --no-index は差分があると 1 を返す
  git --no-pager diff --no-index -- "$SNAPSHOT/flake.lock" "$DOTFILES/flake.lock" || changed=0
  git --no-pager diff --no-index -- "$SNAPSHOT/sources.json" "$SOURCES" || changed=0
  if ((changed)); then
    log "差分はありません"
    return 1
  fi
  return 0
}

# 端末から答えを読み、y か yes (大文字と小文字を区別しない) のときだけ 0 を返す。標準入力からは読まない (docs/adr/0139)
confirm() {
  local answer=""
  printf '適用しますか? [y/N] '
  IFS= read -r answer <"${UPDATE_NIX_TTY:-/dev/tty}" 2>/dev/null || true
  printf '\n'
  case $(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]') in
  y | yes) return 0 ;;
  *) return 1 ;;
  esac
}

build() {
  log "ビルドします (まだ適用しません)"
  nix build --no-link "$DOTFILES#darwinConfigurations.${HOST}.system"
}

switch() {
  log "darwin-rebuild switch で適用します (sudo)"
  if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "$DOTFILES#$HOST"
  else
    # nix-darwin は flake.lock で固定した版を使う (docs/adr/0017)
    sudo nix --extra-experimental-features "nix-command flakes" \
      run --inputs-from "$DOTFILES" nix-darwin -- switch --flake "$DOTFILES#$HOST"
  fi
}

main() {
  local do_switch=1
  case "${1:-}" in
  --no-switch) do_switch=0 ;;
  "") ;;
  *) die "不明な引数です: $1" ;;
  esac

  # 確かめが終わるまで、どのファイルも書かない (docs/adr/0139)
  verify_sources
  snapshot
  update_flake
  update_sources
  log "更新の差分"
  show_diff || exit 0
  build
  if ((do_switch)); then
    if ! confirm; then
      log "適用しませんでした"
      exit 1
    fi
    switch
    log "完了しました"
  else
    log "ビルドまで完了しました。適用するには: sudo darwin-rebuild switch --flake $DOTFILES#$HOST"
  fi
}

# source されたときは関数の定義だけ行う (テスト用)
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
