# Ghostty configuration

# 終了時の確認ダイアログを無効化
confirm-close-surface = false
quit-after-last-window-closed = true

# ⌘P を Kitty プロトコルの super+p (CSI-u: 112='p', 9=super) として nvim に送る。
# nvim 側の <D-p> マッピング (Telescope commands = コマンドパレット) で拾う。
keybind = cmd+p=csi:112;9u

# Ctrl+J の改行(LF)送出を無効化 (子プロセスに送らず破棄)
keybind = ctrl+j=ignore

# 便利な設定 (docs/adr/0044)
# Ghostty は Nix で入れているので、自動更新は止めて bin/update-nix で上げる
auto-update = off
# 配色を nvim (monokai-pro の classic) と揃える
theme = Monokai Classic
# どのアプリからでも Cmd+\ で、画面の上から端末を出し入れする (macOS のアクセシビリティの許可が要る)
keybind = global:cmd+backslash=toggle_quick_terminal
# 終了したときのウィンドウ・タブの配置を、次の起動で戻す
window-save-state = always
# ウィンドウの余白を上下左右で均等にする
window-padding-balance = true
# 日本語の文字 (和文の記号・ひらがな・カタカナ・漢字・全角の英数字) は、等幅のゴシック体の BIZ UDゴシックで表示する。
# 英数字は Ghostty に組み込みの JetBrains Mono のまま (docs/adr/0048)
font-codepoint-map = U+3000-U+303F,U+3040-U+309F,U+30A0-U+30FF,U+31F0-U+31FF,U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF,U+FF00-U+FFEF=BIZ UDGothic
# <- や -> などを 1 つの記号 (合字) にまとめず、1 文字ずつ表示する (JetBrains Mono の合字は calt。docs/adr/0049)
font-feature = -calt
font-feature = -liga
font-feature = -dlig
